#!/bin/sh
# Launched by the desktop session (autostart). Runs Health Display next to Discord and
# relaunches Discord if it hangs on the "Starting..." splash or exits; after repeated
# failed starts it clears Discord's (damaged) web storage first.
mkdir -p "$HOME/.config/discord"
# Discord refuses to start when the installed .deb is outdated; skip that check.
python3 - <<'PY'
import json, os
p = os.path.expanduser("~/.config/discord/settings.json")
try: s = json.load(open(p))
except Exception: s = {}
s["SKIP_HOST_UPDATE"] = True
json.dump(s, open(p, "w"), indent=2)
PY
pkill -f /usr/local/bin/health-display 2>/dev/null
nohup /usr/local/bin/health-display >> "$HOME/health-display.log" 2>&1 &

ipc="${XDG_RUNTIME_DIR:-/tmp}/discord-ipc-0"
fails=0
while true; do
  pkill -f "$HOME/.config/discord/app-" 2>/dev/null; sleep 2
  if [ $fails -ge 2 ]; then
    # Discord's stored web data gets damaged when it's killed mid-write (e.g. a container
    # restart), and then its renderer crashes on every start. Clear that data; the login
    # (Local Storage, Cookies, Local State, Preferences) is kept.
    d="$HOME/.config/discord"
    rm -rf "$d/Service Worker" "$d/Session Storage" "$d/Shared Dictionary" "$d/blob_storage" \
           "$d/discord_asset_cache" "$d/WebStorage" "$d/Cache" "$d/Code Cache" "$d/GPUCache" \
           "$d/DawnGraphiteCache" "$d/DawnWebGPUCache" "$d/DIPS" "$d/DIPS-wal" "$d/VideoDecodeStats" \
           "$d/shared_proto_db" "$d/Network Persistent State" "$d/TransportSecurity" \
           "$d/Trust Tokens" "$d/Trust Tokens-journal" "$d/sentry"
    echo "$(date +%T) discord-session: $fails failed starts, cleared Discord's web storage (login kept)" >> "$HOME/health-display.log"
    fails=0
  fi
  rm -f "$ipc" "$HOME/.config/discord/Singleton"*
  discord --no-sandbox &
  pid=$!
  # The RPC socket only appears once the client has fully loaded. The updater may
  # restart Discord under a new pid, so follow any Discord process, not just $pid.
  alive() { kill -0 $pid 2>/dev/null || pgrep -f "$HOME/.config/discord/app-" >/dev/null; }
  i=0
  while [ $i -lt 180 ] && alive && [ ! -S "$ipc" ]; do sleep 1; i=$((i+1)); done
  if [ ! -S "$ipc" ]; then
    echo "$(date +%T) discord-session: not ready after ${i}s, relaunching" >> "$HOME/health-display.log"
    # Only a hang counts towards clearing storage; a quick exit is just a restart.
    [ $i -ge 180 ] && fails=$((fails+1))
    continue
  fi
  fails=0
  # Wait for whichever Discord process is running now.
  while alive; do sleep 5; done
  echo "$(date +%T) discord-session: discord exited, relaunching" >> "$HOME/health-display.log"
  sleep 5
done
