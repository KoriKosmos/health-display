# Pulsoid token with scope data:heart_rate:read — https://pulsoid.net/ui/keys
PULSOID_TOKEN=
# Application ID from https://discord.com/developers/applications
# The app's NAME is what shows as "Playing <name>", so name the app "Heart Rate".
DISCORD_APP_ID=

# Placeholders: {bpm} {min} {max} {avg}
DETAILS=❤️ {bpm} bpm
STATE=min {min} · avg {avg} · max {max}

# Large image = generated tile with your BPM. IMG_TEXT supports {bpm}
IMAGE=on
IMG_TEXT={bpm}
IMG_BG=ED4245
IMG_FG=FFFFFF

# seconds: Pulsoid poll / min gap between Discord updates / clear after no data
POLL_INTERVAL=3
UPDATE_INTERVAL=15
STALE_AFTER=60
