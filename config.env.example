# Pulsoid token with scope data:heart_rate:read — https://pulsoid.net/ui/keys
PULSOID_TOKEN=
# Application ID from https://discord.com/developers/applications
# The app's NAME is what shows as "Playing <name>", so name the app "Heart Rate".
DISCORD_APP_ID=

# --- Google Health API (optional). OAuth client from your Google Cloud project
# (Web application, redirect URI http://localhost:8765/). Then run: health-display auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ring APIs (optional). They add scores Health Connect doesn't carry and
# fresher ring data; every source is a fallback for the others (see SOURCE_*).
# Ultrahuman: personal token from https://vision.ultrahuman.com/developer
ULTRAHUMAN_TOKEN=
# Oura: OAuth app from https://cloud.ouraring.com/oauth/applications (redirect URI
# http://localhost:8765/), then run: health-display auth oura. Needs an Oura membership.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# --- Presence layout. Segments are separated by " · "; a segment whose
# placeholder has no (fresh) data is left out.
#
# Pulsoid (live):   {bpm} {min} {max} {avg}
# HR fallback:      when Pulsoid has no live reading, {bpm} becomes "~72" from the
#                   newest watch/ring sample, with {bpm_age} ("8 min ago") and {bpm_src}
# Today:            {steps} {distance} (km) {calories} (kcal burned incl. BMR) {active_kcal}
#                   {active} (all active minutes) {active_mv} (moderate+vigorous)
#                   {azm} (active zone minutes) {floors} {kcal_in} (logged food)
# Overnight/daily:  {rhr} {hrv} (ms) {spo2} (%) {resp} (breaths/min) {temp_delta} (°C vs baseline)
#                   {vo2max} {fitness} (cardio fitness level)
# Last sleep:       {sleep} {sleep_eff} (%) {sleep_score} {deep} {rem} {light} {awake}
# Ring scores:      {readiness} {stress} (Restored/Normal/Stressful) {stress_high} {recovery_high}
#                   {resilience} {activity_score} (Oura); {recovery} {movement} (Ultrahuman)
# Last 24h:         {workout} {workout_time} {glucose} (mmol/L) {glucose_mgdl} {ecg}
# Last 30 days:     {weight} (kg)
# Phone push only:  {mindful}
# Which device was used: {steps_src} {sleep_src} {rhr_src} {hrv_src} (and {<total>_src}
# for distance/active/active_kcal/azm)
DETAILS=❤️ {bpm} bpm · {bpm_age} · RHR {rhr} · HRV {hrv}ms
STATE=👟 {steps} · 😴 {sleep} · 💤 {sleep_score}/100 · 🔋 {readiness} · ♻️ {recovery} · ⏱ {active} min
IMG_HOVER=🔥 {calories} kcal · ⚡ {azm} AZM · 🏃 {workout} {workout_time} · 🧠 {stress} · 🫁 {spo2}% · 🌡 {temp_delta}°C · ↕ {min}–{max} bpm

# Every device/app is a fallback for the others, so whatever you happened to
# wear is used. Today's totals come from whichever source counted the most
# (never added together); overnight stats and sleep come from the most recent
# night any source recorded. Sources: watch, oura, ultrahuman, samsung,
# phone, or an app's package name for anything else writing to Health Connect;
# * stands for every source not listed. The order only breaks ties (same
# night or same count). SOURCE_<GROUP> overrides it for HR, STEPS, DISTANCE,
# ACTIVE, ACTIVE_MV, CALORIES, AZM, SLEEP, RHR, HRV, SPO2, RESP, TEMP, VO2.
SOURCE_DEFAULT=watch,oura,ultrahuman,*,samsung,phone
#SOURCE_SLEEP=oura,watch,*
# {calories} and {floors} only exist as Google rollups: google-wearables
# (Fitbit/Pixel) or all-sources.
ROLLUP_SOURCES=google-wearables
# Overnight stats/sleep older than this many days are hidden.
STAT_MAX_AGE_DAYS=1.5

# --- Phone push (Health Display for Android). While the phone app is active and
# has a live heart rate it POSTs its values to the server, and the server's
# presence uses them: the phone's values win and the server's own stats fill
# what the phone doesn't send (like ring scores). When the phone has no live
# heart rate its stats still count, but the heart rate comes from the server's
# own sources (Pulsoid, then the watch/ring HR fallback). Both apps read this file, so importing it on
# the phone sets both sides up. Spec: health-display-android/docs/server-push.md
# Shared secret; push is off on both sides while empty. Generate: openssl rand -hex 32
PUSH_TOKEN=
# Phone only: where the phone posts (the server's /push endpoint).
PUSH_URL=
# Server only: listen port, and seconds without a valid push before the phone
# counts as inactive and the server falls back to its own sources.
PUSH_PORT=8766
PUSH_STALE_AFTER=60

# --- Status API (optional): GET /status on PUSH_PORT returns what the presence
# shows plus every value as JSON (e.g. for a website). Read-only bearer token,
# separate from PUSH_TOKEN; off while empty. Generate: openssl rand -hex 32
STATUS_TOKEN=

# Large image = generated tile with your BPM. IMG_TEXT supports {bpm}
IMAGE=on
IMG_TEXT={bpm}
IMG_BG=ED4245
IMG_FG=FFFFFF

# seconds: Pulsoid poll / min gap between Discord updates / clear after no data
# / Google Health refresh
POLL_INTERVAL=3
UPDATE_INTERVAL=15
STALE_AFTER=60
GOOGLE_INTERVAL=300
# HR fallback: max age of a non-live reading to show (0 = off) / how often to check
HR_FALLBACK_MAX_AGE=900
HR_FALLBACK_INTERVAL=60
