# Pulsoid token with scope data:heart_rate:read — https://pulsoid.net/ui/keys
PULSOID_TOKEN=
# Application ID from https://discord.com/developers/applications
# The app's NAME is what shows as "Playing <name>", so name the app "Heart Rate".
DISCORD_APP_ID=

# --- Google Health API (optional). OAuth client from your Google Cloud project
# (Web application, redirect URI http://localhost:8765/). Then run: health-display auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Presence layout. Segments are separated by " · "; a segment whose
# placeholder has no (fresh) data is left out.
#
# Pulsoid (live):   {bpm} {min} {max} {avg}
# Today:            {steps} {distance} (km) {calories} (kcal burned) {active} (all active
#                   minutes) {active_mv} (moderate+vigorous) {azm} (active zone minutes)
#                   {floors} {kcal_in} (logged food)
# Overnight/daily:  {rhr} {hrv} (ms) {spo2} (%) {resp} (breaths/min) {temp_delta} (°C vs baseline)
#                   {vo2max} {fitness} (cardio fitness level)
# Last sleep:       {sleep} {sleep_eff} (%) {deep} {rem} {light} {awake}
# Last 24h:         {workout} {workout_time} {glucose} (mmol/L) {glucose_mgdl} {ecg}
# Last 30 days:     {weight} (kg)
DETAILS=❤️ {bpm} bpm · RHR {rhr} · HRV {hrv}ms
STATE=👟 {steps} · ⏱ {active} min active · 😴 {sleep}
IMG_HOVER=min {min} · avg {avg} · max {max}

# Which device a stat comes from: comma-separated preference order of
# watch, oura, ultrahuman, any. SOURCE_<GROUP> overrides the default for
# SLEEP, RHR, HRV, SPO2, RESP, TEMP, VO2.
SOURCE_DEFAULT=watch,oura,ultrahuman,any
#SOURCE_SLEEP=oura,watch
# Today's totals: google-wearables (watch only) or all-sources (adds phone
# step counting etc. — usually double-counts).
ROLLUP_SOURCES=google-wearables
# Overnight stats/sleep older than this many days are hidden.
STAT_MAX_AGE_DAYS=1.5

# Large image = generated tile with your BPM. IMG_TEXT supports {bpm}
IMAGE=on
IMG_TEXT={bpm}
IMG_BG=ED4245
IMG_FG=FFFFFF

# seconds: Pulsoid poll / min gap between Discord updates / clear after no data
# / Google Health refresh
POLL_INTERVAL=3
UPDATE_INTERVAL=15
STALE_AFTER=60
GOOGLE_INTERVAL=300
